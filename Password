<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<title>パスワード保護＆履歴ログサンプル</title>
<style>
  body { font-family: sans-serif; padding: 20px; background: #f4f4f9; }
  .box { background: white; padding: 15px; border-radius: 8px; margin-bottom: 15px; box-shadow: 0 2px 5px rgba(0,0,0,0.1); }
  button { padding: 8px 14px; cursor: pointer; background: #007bff; color: white; border: none; border-radius: 4px; }
  button:hover { background: #0056b3; }
  input { padding: 7px; border: 1px solid #ccc; border-radius: 4px; }
  table { width: 100%; border-collapse: collapse; margin-top: 10px; }
  th, td { border: 1px solid #ddd; padding: 8px; text-align: left; font-size: 14px; }
  th { background: #eee; }
</style>
</head>
<body>

  <!-- 1. 操作する人の名前入力 -->
  <div class="box">
    <h3>① 操作者名</h3>
    <input type="text" id="userName" placeholder="名前を入力（例：みぃす）">
  </div>

  <!-- 2. ロックされた機能の実行ボタン -->
  <div class="box">
    <h3>② パスワード必須の機能</h3>
    <button onclick="runProtectedAction('盤面リセット')">ロックされた機能を実行</button>
    <button onclick="changePassword()" style="background:#6c757d;">パスワード変更</button>
  </div>

  <!-- 3. 誰がいつやったかの履歴表示 -->
  <div class="box">
    <h3>③ 操作履歴ログ（誰が・いつ）</h3>
    <button onclick="viewLogs()">ログを表示（要パスワード）</button>
    <div id="logArea" style="display:none;">
      <table>
        <thead>
          <tr><th>日時</th><th>操作者</th><th>内容</th></tr>
        </thead>
        <tbody id="logTableBody"></tbody>
      </table>
    </div>
  </div>

<script>
  // 初期パスワード（ブラウザに保存されていなければ '1234' になる）
  const PASS_KEY = 'tool_admin_password';
  const LOG_KEY  = 'tool_action_logs';

  if (!localStorage.getItem(PASS_KEY)) {
    localStorage.setItem(PASS_KEY, '1234');
  }

  // パスワード認証の共通関数
  function checkPassword() {
    const input = prompt('パスワードを入力してください：');
    if (input === null) return false; // キャンセル時
    const savedPass = localStorage.getItem(PASS_KEY);
    if (input === savedPass) {
      return true;
    } else {
      alert('パスワードが違います！');
      return false;
    }
  }

  // パスワードが必要な処理を実行する例
  function runProtectedAction(actionName) {
    // まずパスワードを確認
    if (!checkPassword()) return;

    // 認証成功後の処理
    alert(`認証成功！「${actionName}」を実行しました。`);
    saveLog(actionName); // 履歴に記録
  }

  // 履歴を保存する関数
  function saveLog(actionName) {
    const user = document.getElementById('userName').value.trim() || 'ゲスト';
    const now = new Date().toLocaleString('ja-JP'); // 例: 2026/11/26 11:30:00

    // 既存のログを取得して先頭に追加
    const logs = JSON.parse(localStorage.getItem(LOG_KEY) || '[]');
    logs.unshift({ time: now, user: user, action: actionName });
    localStorage.setItem(LOG_KEY, JSON.stringify(logs));
  }

  // ログ一覧を表示する関数（これもパスワードで保護）
  function viewLogs() {
    if (!checkPassword()) return;

    const logs = JSON.parse(localStorage.getItem(LOG_KEY) || '[]');
    const tbody = document.getElementById('logTableBody');
    tbody.innerHTML = logs.map(log => 
      `<tr><td>${log.time}</td><td>${log.user}</td><td>${log.action}</td></tr>`
    ).join('');

    document.getElementById('logArea').style.display = 'block';
  }

  // パスワード変更機能
  function changePassword() {
    if (!checkPassword()) return;
    const newPass = prompt('新しいパスワードを入力してください：');
    if (newPass && newPass.trim() !== '') {
      localStorage.setItem(PASS_KEY, newPass.trim());
      alert('パスワードを変更しました！');
    }
  }
</script>

</body>
</html>
